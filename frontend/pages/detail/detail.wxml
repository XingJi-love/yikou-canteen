<!--
  菜品详情页模板（pages/detail/detail.wxml）
  顶部自定义导航栏 → 菜品大图 → 信息卡片（名称/价格/描述） → 底部加入购物车按钮
-->
<view class="detail-page">
  <!-- 顶部自定义导航栏 -->
  <view class="nav-bar" style="padding-top: {{statusBarHeight}}px;">
    <view class="nav-content" style="height: {{navBarHeight}}px;">
      <view class="nav-back" bindtap="goBack">
        <text class="back-icon">‹</text>
      </view>
      <text class="nav-title">菜品详情</text>
    </view>
  </view>

  <!-- 加载状态 -->
  <view class="loading-container" wx:if="{{ loading }}">
    <text>加载中...</text>
  </view>

  <!-- 内容区域 -->
  <scroll-view scroll-y class="content-scroll" wx:if="{{ !loading }}">
    <!-- 菜品大图展示区 -->
    <view class="food-image-wrap">
      <image 
        class="food-image" 
        src="{{ food.image_url }}" 
        mode="aspectFill"
        lazy-load
      />
    </view>

    <!-- 菜品信息卡片（白色圆角，层叠效果） -->
    <view class="info-card">
      <!-- 名称 + 价格行 -->
      <view class="name-price-row">
        <text class="food-name">{{ food.name }}</text>
        <text class="food-price">¥{{ food.price }}</text>
      </view>

      <!-- 菜品详细描述 -->
      <view class="description" wx:if="{{ food.description }}">
        <text>{{ food.description }}</text>
      </view>
    </view>
  </scroll-view>

  <!-- 底部固定操作栏：加入购物车按钮 -->
  <view class="bottom-bar" wx:if="{{ !loading }}">
    <button class="add-cart-btn" bindtap="addToCart">
      加入购物车
    </button>
  </view>
</view>
